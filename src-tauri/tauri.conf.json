{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BebekonCode",
  "version": "../package.json",
  "identifier": "com.bebekon.agent-workspace",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BebekonCode",
        "width": 1440,
        "height": 920,
        "minWidth": 850,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Локальная среда для ИИ-помощников по программированию",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": {
          "ru-RU": {
            "localePath": "./wix/locales/ru-RU.wxl"
          }
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0N0Q2QTkyMEYzMjQzRjIKUldUeVF6SVBrbXA5RkpVNi9KTjk2c3YrOVR5ek96UFIwZlh2dDA5dU5kTEVrcGw2cExTNlErVHIK",
      "endpoints": [
        "https://github.com/Bebekon12/BebekonCode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
