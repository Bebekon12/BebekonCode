{
  "name": "bebekoncode",
  "version": "0.8.7",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "node scripts/native-smoke.mjs",
    "package": "node scripts/desktop.mjs build",
    "tauri": "tauri",
    "check:versions": "node scripts/check-versions.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,mjs,yml,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,mjs,yml,md,html}\"",
    "test:updater": "node scripts/updater-audit.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.25.12",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
